    <sql>SELECT country_iso3, year, 'Manufacturing' as sector_name,
MAX(CASE WHEN indicator_code = 'NV.IND.MANF.ZS' THEN value END) AS value_added_pct_gdp,
MAX(CASE WHEN indicator_code = 'NV.IND.MANF.CD' THEN value END) AS value_added_usd,
CAST(NULL AS DECIMAL(20,6)) AS employment_pct
FROM wdi_indicators
WHERE indicator_code IN ('NV.IND.MANF.CD','NV.IND.MANF.ZS')
GROUP BY country_iso3, year, sector_name
ORDER BY country_iso3, year;</sql>
