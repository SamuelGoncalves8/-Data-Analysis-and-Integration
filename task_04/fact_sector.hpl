MAX(CASE WHEN indicator_code = 'NV.IND.TOTL.CD' THEN value END) AS value_added_usd,
MAX(CASE WHEN indicator_code = 'SL.IND.EMPL.ZS' THEN value END) AS employment_pct
FROM wdi_indicators
WHERE indicator_code IN ('NV.IND.TOTL.ZS','NV.IND.TOTL.CD', 'SL.IND.EMPL.ZS')
GROUP BY country_iso3, year, sector_name
ORDER BY country_iso3, year;</sql>
