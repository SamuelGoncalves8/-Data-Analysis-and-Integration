  <transform>
    <name>Agrculture</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>staging</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>SELECT country_iso3, year, 'Agriculture' as sector_name,
MAX(CASE WHEN indicator_code = 'NV.AGR.TOTL.ZS' THEN value END) AS value_added_pct_gdp,
MAX(CASE WHEN indicator_code = 'NV.AGR.TOTL.CD' THEN value END) AS value_added_usd,
MAX(CASE WHEN indicator_code = 'SL.AGR.EMPL.ZS' THEN value END) AS employment_pct
FROM wdi_indicators
WHERE indicator_code IN ('NV.AGR.TOTL.ZS','NV.AGR.TOTL.CD', 'SL.AGR.EMPL.ZS')
GROUP BY country_iso3, year, sector_name
ORDER BY country_iso3, year;</sql>
    <variables_active>N</variables_active>
    <attributes/>
    <GUI>
      <xloc>112</xloc>
      <yloc>112</yloc>
    </GUI>
  </transform>
  <transform>
