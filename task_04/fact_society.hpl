    <connection>staging</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>SELECT country_iso3, year AS year_temp,
MAX(CASE WHEN indicator_code = 'NY.GNP.PCAP.CD' THEN value END) AS gni_per_capita,
MAX(CASE WHEN indicator_code = 'SP.DYN.LE00.IN' THEN value END) AS life_expectancy,
MAX(CASE WHEN indicator_code = 'SP.URB.TOTL.IN.ZS' THEN value END) AS urban_pop_pct
FROM wdi_indicators
WHERE indicator_code IN ('NY.GNP.PCAP.CD', 'SP.DYN.LE00.IN', 'SP.URB.TOTL.IN.ZS')
GROUP BY country_iso3, year;</sql>
    <variables_active>N</variables_active>
