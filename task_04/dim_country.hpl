  <transform>
    <name>Table input</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>staging</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>SELECT DISTINCT w.country_iso3 AS iso3_code,
w.country_name, c.country_group
FROM wdi_indicators w
JOIN country_mapping c
ON w.country_iso3 = c.iso3_code;</sql>
